      {
        "date": "2026-11-05",
        "id": "paper:b371b4cddfe3a19a",
        "kind": "paper",
        "label": "Nov 5, 2026 6:00 PM CT",
        "note": "X-rays with wavelengths between approximately 2.3 and 4.4 nanometers, i.e., in the so-called water window, are particularly well suited to examining biological samples in their natural, aqueous environment. To date, however, it has been technically difficult to access this type of radiation at an appropriate quality and intensity, as only free-electron lasers in large-scale accelerator systems are capable of generating it.",
        "published": "2026-11-05T18:00:02-06:00",
        "section": "Frontier lab",
        "severity": "",
        "source": "Phys.org physics",
        "title": "Laser-plasma accelerator could generate bright X-rays for biological imaging, simulations show",
        "url": "https://phys.org/news/2026-11-laser-plasma-generate-bright-rays.html"
      },
      {
        "date": "2026-11-05",
        "id": "paper:275cad864bfae04a",
        "kind": "paper",
        "label": "Nov 5, 2026 5:10 PM CT",
        "note": "In the first fraction of a second following the Big Bang, matter existed as a trillion-degree plasma of quarks and gluons—subatomic particles that zinged around at close to the speed of light. This roiling soup lasted for just a few microseconds before the particles coalesced into more stable protons and neutrons.",
        "published": "2026-11-05T17:10:01-06:00",
        "section": "Frontier lab",
        "severity": "",
        "source": "Phys.org physics",
        "title": "Pinning down the structure of quark-gluon plasma, the universe's first fluid",
        "url": "https://phys.org/news/2026-11-pinning-quark-gluon-plasma-universe.html"
      },
