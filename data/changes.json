      {
        "date": "2026-11-15",
        "id": "paper:27f0f499c9da2417",
        "kind": "paper",
        "label": "Nov 15, 2026 10:40 AM CT",
        "note": "When a cloud of atoms is cooled close to absolute zero, its atoms can merge into a Bose–Einstein condensate (BEC): an exotic fluid in which atoms across the whole cloud share a single quantum state. Current theories predict that as a disordered quantum gas settles into this ordered state, a tangle of tiny vortices should form and gradually unravel.",
        "published": "2026-11-15T10:40:01-06:00",
        "section": "Frontier lab",
        "severity": "",
        "source": "Phys.org physics",
        "title": "Tangled quantum whirlpools caught unraveling in an ultracold gas",
        "url": "https://phys.org/news/2026-11-tangled-quantum-whirlpools-caught-unraveling.html"
      },
      {
        "date": "2026-11-13",
        "id": "paper:0ecc22393642fbf1",
        "kind": "paper",
        "label": "Nov 13, 2026 11:28 AM CT",
        "note": "Clinical world models expose language-model agents to predicted patient responses, but simulations can be unreliable for poorly supported treatments or unfamiliar hospitals. We introduce Support-Gated World-Model decision support, a lightweight extension of a propose--simulate--refine agent.",
        "published": "2026-11-13T11:28:25-06:00",
        "section": "Frontier lab",
        "severity": "",
        "source": "arXiv cs.AI",
        "title": "When to Trust Simulated Patient Responses:Support-Gated World Models for Vasopressor Decision Support",
        "url": "https://arxiv.org/abs/2611.18458v1"
      },
      {
        "date": "2026-11-13",
        "id": "paper:93aa95c7d7efda54",
        "kind": "paper",
        "label": "Nov 13, 2026 11:26 AM CT",
        "note": "Reliable use of large language models (LLMs) requires uncertainty estimates that separate ambiguity intrinsic to a prompt from genuine knowledge gaps. Bayesian and deep-ensemble methods deliver this aleatoric/epistemic decomposition in principle, but are computationally prohibitive at LLM scale and require white-box access.",
        "published": "2026-11-13T11:26:39-06:00",
        "section": "Frontier lab",
        "severity": "",
        "source": "arXiv cs.AI",
        "title": "Black-Box Uncertainty Quantification for Large Language Models via Ensemble-of-Ensembles",
        "url": "https://arxiv.org/abs/2611.18453v1"
      },
      {
        "date": "2026-11-13",
        "id": "paper:214f5f3a4bc4310e",
        "kind": "paper",
        "label": "Nov 13, 2026 11:14 AM CT",
        "note": "The EU AI Act imposes technical and organizational requirements for high-risk AI systems, but applying these requirements involves contextual choices about what to measure and what evidence supports a compliance claim. We investigate these challenges through a participatory workshop involving 32 researchers, policymakers, and practitioners from different disciplines, using realistic scenarios in healthcare, recruitment, and public transport to examine how regulatory obligations are interpreted, ",
        "published": "2026-11-13T11:14:37-06:00",
        "section": "Frontier lab",
        "severity": "",
        "source": "arXiv cs.AI",
        "title": "Between Obligations and Evidence: A Participatory Study of Translating the EU AI Act into Technical Requirements",
        "url": "https://arxiv.org/abs/2611.18439v1"
      },
      {
        "date": "2026-11-13",
        "id": "paper:54f02531ca1ca449",
        "kind": "paper",
        "label": "Nov 13, 2026 11:13 AM CT",
        "note": "Automated sleep staging has achieved strong bench- mark accuracy; however, clinical adoption remains limited due to a lack of interpretability. In this work, we fill the research gap by extending the SleepXAI sleep staging framework to systematically compare five different XAI methods.",
        "published": "2026-11-13T11:13:23-06:00",
        "section": "Frontier lab",
        "severity": "",
        "source": "arXiv cs.AI",
        "title": "Towards Explainable Sleep Stage Classification using Single-Channel Electroencephalogram",
        "url": "https://arxiv.org/abs/2611.18434v1"
      },
